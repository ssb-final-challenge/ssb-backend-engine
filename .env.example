LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret
PORT=8787
JWT_SECRET=replace-with-a-long-random-secret
# Comma-separated Apple Bundle IDs accepted during development/team testing.
APPLE_BUNDLE_IDS=com.dinaseptyp.exportra.liveinspection,com.example.team2,com.example.team3
# APPLE_BUNDLE_ID remains supported for a single Bundle ID.
PRIVACY_CONTACT_EMAIL=privacy@your-domain.com

# Supabase shared transaction-mode pooler (application queries)
DATABASE_URL="postgresql://postgres.akdqzqjfbmnbafwodxbe:[YOUR-PASSWORD]@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Supabase shared session-mode pooler (Prisma migrations)
DIRECT_URL="postgresql://postgres.akdqzqjfbmnbafwodxbe:[YOUR-PASSWORD]@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres"
